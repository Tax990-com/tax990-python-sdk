# Tax990 SDK Configuration
TAX990_CLIENT_ID=your_client_id
TAX990_CLIENT_SECRET=your_client_secret_id
TAX990_USER_TOKEN=your_user_token
TAX990_ENVIRONMENT=sandbox

# Optional: override base URLs
TAX990_API_URL=http://localhost:9005
TAX990_OAUTH_URL=http://localhost:4000

# Optional: webhook secret for signature verification
TAX990_WEBHOOK_SECRET=your_webhook_secret
